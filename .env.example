# Copier en .env et adapter. Valeurs factices uniquement : ce fichier est public.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Schéma + hôte, sans slash final
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Par défaut : actif si DEBUG est faux
# DJANGO_SECURE_SSL_REDIRECT=False

DATABASE_URL=postgres://portfolio:change-me@db:5432/portfolio
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me

# En dev : console uniquement, aucun vrai compte d'envoi
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
