# Copier en .env et adapter. Valeurs factices uniquement : ce fichier est public.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Schéma + hôte, sans slash final
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Par défaut : actif si DEBUG est faux
# DJANGO_SECURE_SSL_REDIRECT=False

DATABASE_URL=postgres://portfolio:change-me@db:5432/portfolio
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me

# En dev : console uniquement, aucun vrai compte d'envoi
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.exemple.test
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Expéditeur = le compte SMTP ; destinataire des messages du formulaire
DEFAULT_FROM_EMAIL=portfolio@exemple.test
CONTACT_RECIPIENT=moi@exemple.test
# Alerte ntfy à chaque envoi du formulaire (vide : pas d'alerte). Le sujet est un secret.
CONTACT_NTFY_URL=

# Anti-robot du formulaire. Ci-dessous : les clés de test publiques de Cloudflare
# (le défi réussit toujours). En prod : la paire du widget créé dans Cloudflare.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Limites d'envoi (valeurs par défaut)
# CONTACT_LIMIT_PER_IP_PER_HOUR=3
# CONTACT_LIMIT_PER_DAY=50
